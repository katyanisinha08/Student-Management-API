			"request": {
				"method": "DELETE",
				"header": [],
				"url": { "raw": "http://localhost:3000/api/students/2", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["api", "students", "2"] }
			}
		},
		{
			"name": "5. Test Validation Error (400 Bad Request)",
			"request": {
				"method": "POST",
				"header": [{ "key": "Content-Type", "value": "application/json" }],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"\",\n    \"age\": -5\n}"
